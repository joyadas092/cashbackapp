# --- Database ---
# Port 5433 (not the default 5432) — this project's docker-compose maps to a
# non-default host port so it doesn't collide with other local Postgres containers.
DATABASE_URL="postgresql://cashback:cashback@localhost:5433/cashbackapp?schema=public"

# Separate database for integration tests (src/lib/postback/processor.test.ts) so
# `npm run test:integration` never truncates your dev/demo data. Create it once with:
#   docker compose exec postgres psql -U cashback -d postgres -c "CREATE DATABASE cashbackapp_test;"
#   DATABASE_URL=$TEST_DATABASE_URL npx prisma migrate deploy
TEST_DATABASE_URL="postgresql://cashback:cashback@localhost:5433/cashbackapp_test?schema=public"

# --- Redis (optional in dev; app runs with in-process no-op cache if unset) ---
# Port 6380 (not the default 6379) for the same reason.
REDIS_URL="redis://localhost:6380"

# --- NextAuth ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Cuelinks (server-side only, never expose to the browser) ---
# Leave blank to run the Cuelinks adapter in stub mode (fake data, no network calls).
# Rotate/regenerate any key that has been visible in a screenshot or shared publicly
# before pasting it here. Get a v3 scoped key at cuelinks.com/api-key.
CUELINKS_API_KEY=""
CUELINKS_CHANNEL_ID=""
# Shared secret configured on the Cuelinks Global Postback "constant parameter" (token).
# Used to verify POST /api/webhooks/cuelinks requests. Added in Phase 2.
CUELINKS_POSTBACK_SECRET=""
