generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

enum RiskStatus {
  NORMAL
  REVIEW
  RESTRICTED
  BLOCKED

  @@map("risk_status")
}

enum StoreStatus {
  ACTIVE
  INACTIVE

  @@map("store_status")
}

enum CashbackType {
  PERCENTAGE
  FIXED

  @@map("cashback_type")
}

enum ClickType {
  DIRECT_CASHBACK
  VISIT_STORE
  PROFIT_LINK

  @@map("click_type")
}

enum ClickStatus {
  TRACKED
  FAILED

  @@map("click_status")
}

// WITHDRAWAL is added in Phase 3 alongside the withdrawals feature.
enum WalletTxType {
  CASHBACK_PENDING
  CASHBACK_CONFIRMED
  CASHBACK_REVERSED
  ADJUSTMENT
  PROFIT_LINK_EARNING
  PROFIT_LINK_EARNING_REVERSED
  REFERRAL_EARNING
  REFERRAL_EARNING_REVERSED

  @@map("wallet_tx_type")
}

enum WalletTxStatus {
  PENDING
  COMPLETED
  REVERSED

  @@map("wallet_tx_status")
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  REVERSED
  PAID

  @@map("transaction_status")
}

enum ReferralStatus {
  ACTIVE
  EXPIRED
  BLOCKED

  @@map("referral_status")
}

enum ProfitLinkStatus {
  ACTIVE
  DISABLED

  @@map("profit_link_status")
}

// ---------------------------------------------------------------------------
// Users / Wallet
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phone        String?    @unique
  passwordHash String     @map("password_hash")
  name         String
  role         UserRole   @default(USER)
  referralCode String     @unique @map("referral_code")
  riskStatus   RiskStatus @default(NORMAL) @map("risk_status")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  profile            UserProfile?
  wallet             Wallet?
  clicks             Click[]
  walletTransactions WalletTransaction[]
  auditLogs          AuditLog[]
  profitLinks        ProfitLink[]
  referralsMade      Referral[]          @relation("ReferrerOf")
  referredBy         Referral?           @relation("ReferredBy")
  favorites          StoreFavorite[]

  @@map("users")
}

model UserProfile {
  id                String  @id @default(cuid())
  userId            String  @unique @map("user_id")
  upiId             String? @map("upi_id")
  bankDetails       Json?   @map("bank_details")
  kycStatus         String? @map("kyc_status")
  notificationPrefs Json    @default("{}") @map("notification_prefs")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Wallet {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  pendingCashback  Decimal  @default(0) @map("pending_cashback") @db.Decimal(12, 2)
  confirmedBalance Decimal  @default(0) @map("confirmed_balance") @db.Decimal(12, 2)
  availableBalance Decimal  @default(0) @map("available_balance") @db.Decimal(12, 2)
  withdrawn        Decimal  @default(0) @map("withdrawn") @db.Decimal(12, 2)
  lifetimeEarned   Decimal  @default(0) @map("lifetime_earned") @db.Decimal(12, 2)
  updatedAt        DateTime @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id                  String         @id @default(cuid())
  walletId            String         @map("wallet_id")
  userId              String         @map("user_id")
  type                WalletTxType
  amount              Decimal        @db.Decimal(12, 2)
  currency            String         @default("INR")
  source              String?
  sourceTransactionId String?        @map("source_transaction_id")
  status              WalletTxStatus @default(PENDING)
  description         String?
  createdAt           DateTime       @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sourceTransactionId, userId, type], name: "wallet_tx_dedupe")
  @@index([walletId, createdAt])
  @@index([sourceTransactionId])
  @@map("wallet_transactions")
}

// ---------------------------------------------------------------------------
// Stores / Categories / Campaigns
// ---------------------------------------------------------------------------

model StoreCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  icon        String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  stores Store[]

  @@map("store_categories")
}

model Store {
  id                  String       @id @default(cuid())
  name                String
  slug                String       @unique
  logoUrl             String       @map("logo_url")
  bannerUrl           String?      @map("banner_url")
  faviconUrl          String?      @map("favicon_url")
  brandColor          String?      @map("brand_color")
  categoryId          String       @map("category_id")
  cashbackType        CashbackType @default(PERCENTAGE) @map("cashback_type")
  cashbackRate        Decimal      @map("cashback_rate") @db.Decimal(5, 2)
  cashbackDisplayText String       @map("cashback_display_text")
  description         String?
  terms               String?
  status              StoreStatus  @default(ACTIVE)
  featured            Boolean      @default(false)
  ranking             Int          @default(0)
  profitLinkEligible  Boolean      @default(false) @map("profit_link_eligible")
  cashbackEligible    Boolean      @default(true) @map("cashback_eligible")
  couponVisible       Boolean      @default(false) @map("coupon_visible")
  cuelinksCampaignId  String?      @map("cuelinks_campaign_id")
  merchantDomains     String[]     @default([]) @map("merchant_domains")
  seoTitle            String?      @map("seo_title")
  seoDescription      String?      @map("seo_description")

  // --- Store-page presentation, all admin-editable per store -----------------
  // Cuelinks exposes one flat payout per campaign (Flipkart: 6% "Per Sale(%)")
  // and no per-category rates, no coupons, and no payment timelines. Everything
  // below is therefore ours to maintain, not something a sync can fill in.
  tagline        String? // one-liner under the store name
  previousRate   Decimal? @map("previous_rate") @db.Decimal(5, 2) // powers the "Was 6%" chip
  visitTime      String?  @map("visit_time") // e.g. "7 Days"
  trackingTime   String?  @map("tracking_time") // e.g. "24 - 48 Hours"
  paymentTime    String?  @map("payment_time") // e.g. "60 - 90 Days"
  storePolicies  String?  @map("store_policies") // "Store Policies" tab body
  importantTips  String[] @default([]) @map("important_tips")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category      StoreCategory       @relation(fields: [categoryId], references: [id])
  campaigns     Campaign[]
  clicks        Click[]
  cashbackRules CashbackRule[]
  profitLinks   ProfitLink[]
  transactions  Transaction[]
  categoryRates StoreCashbackRate[]
  offers        StoreOffer[]
  favorites     StoreFavorite[]

  @@index([categoryId])
  @@index([status, featured, ranking])
  @@map("stores")
}

/// A user's saved store. The unique pair is what makes the favorite toggle
/// idempotent — double-clicking the button can never create two rows.
model StoreFavorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  storeId   String   @map("store_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([userId])
  @@map("store_favorites")
}

/// One row of the store page's category rate table ("Mobiles & Tablets — Up to 8%").
/// Cuelinks has no per-category rate data, so these are entered in the admin panel.
/// `displayText` is stored verbatim rather than computed because merchants publish
/// these as marketing copy ("Up to 8%", "Flat 5%", "Not eligible").
model StoreCashbackRate {
  id          String   @id @default(cuid())
  storeId     String   @map("store_id")
  label       String
  displayText String   @map("display_text")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, sortOrder])
  @@map("store_cashback_rates")
}

/// A coupon/offer card in the store page's "Best Offers for You" panel.
/// The Cuelinks offers API returns nothing for several campaigns we carry
/// (Flipkart included), so these are admin-managed too.
model StoreOffer {
  id          String    @id @default(cuid())
  storeId     String    @map("store_id")
  badge       String? // small tag, e.g. "EXTRA"
  title       String
  description String?
  code        String? // coupon code shown in the pill; null renders no pill
  validTill   DateTime? @map("valid_till")
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, sortOrder])
  @@map("store_offers")
}

model Campaign {
  id                 String    @id @default(cuid())
  storeId            String    @map("store_id")
  cuelinksCampaignId String    @unique @map("cuelinks_campaign_id")
  name               String
  status             String    @default("active")
  commissionType     String?   @map("commission_type")
  commissionValue    Decimal?  @map("commission_value") @db.Decimal(5, 2)
  rawPayload         Json?     @map("raw_payload")
  lastSyncedAt       DateTime? @map("last_synced_at")

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  clicks       Click[]
  profitLinks  ProfitLink[]
  transactions Transaction[]

  @@index([storeId])
  @@map("campaigns")
}

// ---------------------------------------------------------------------------
// Clicks
// ---------------------------------------------------------------------------

model Click {
  id           String      @id @default(cuid())
  userId       String?     @map("user_id")
  storeId      String      @map("store_id")
  campaignId   String?     @map("campaign_id")
  clickType    ClickType   @map("click_type")
  originalUrl  String      @map("original_url")
  trackingUrl  String      @map("tracking_url")
  subid        String?
  subid2       String?
  subid3       String?
  subid4       String?
  subid5       String?
  userAgent    String?     @map("user_agent")
  deviceType   String?     @map("device_type")
  country      String?
  status       ClickStatus @default(TRACKED)
  profitLinkId String?     @map("profit_link_id")
  createdAt    DateTime    @default(now()) @map("created_at")

  user         User?         @relation(fields: [userId], references: [id])
  store        Store         @relation(fields: [storeId], references: [id])
  campaign     Campaign?     @relation(fields: [campaignId], references: [id])
  profitLink   ProfitLink?   @relation(fields: [profitLinkId], references: [id])
  transactions Transaction[]

  @@index([userId])
  @@index([storeId])
  @@index([createdAt])
  @@index([profitLinkId])
  @@map("clicks")
}

// ---------------------------------------------------------------------------
// Share & Earn (profit links)
// ---------------------------------------------------------------------------

model ProfitLink {
  id             String           @id @default(cuid())
  code           String           @unique
  userId         String           @map("user_id")
  storeId        String           @map("store_id")
  campaignId     String?          @map("campaign_id")
  originalUrl    String           @map("original_url")
  destinationUrl String           @map("destination_url")
  clickCount     Int              @default(0) @map("click_count")
  status         ProfitLinkStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  store    Store     @relation(fields: [storeId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id])
  clicks   Click[]

  @@index([userId])
  @@index([code])
  @@map("profit_links")
}

// ---------------------------------------------------------------------------
// Refer & Earn
// ---------------------------------------------------------------------------

model Referral {
  id             String         @id @default(cuid())
  referrerId     String         @map("referrer_id")
  referredUserId String         @unique @map("referred_user_id")
  code           String
  status         ReferralStatus @default(ACTIVE)
  totalEarned    Decimal        @default(0) @map("total_earned") @db.Decimal(12, 2)
  createdAt      DateTime       @default(now()) @map("created_at")

  referrer     User @relation("ReferrerOf", fields: [referrerId], references: [id])
  referredUser User @relation("ReferredBy", fields: [referredUserId], references: [id])

  @@index([referrerId])
  @@map("referrals")
}

model ReferralRule {
  id              String   @id @default(cuid())
  fixedBonus      Decimal? @map("fixed_bonus") @db.Decimal(12, 2)
  durationDays    Int?     @map("duration_days")
  maxTotalEarning Decimal? @map("max_total_earning") @db.Decimal(12, 2)
  minOrderValue   Decimal? @map("min_order_value") @db.Decimal(12, 2)
  isActive        Boolean  @default(true) @map("is_active")

  // --- Public landing page (/refer-earn), all admin-editable ----------------
  // headlineRatePct is the advertised "get X% of our income" figure. It is
  // deliberately separate from CashbackRule.referralPct, which is the per-store
  // split the payout engine actually applies: stores differ, so no single
  // per-store number is honest to advertise site-wide. Changing this changes a
  // public promise, so it is edited in one place rather than hardcoded in JSX.
  headlineRatePct Decimal? @map("headline_rate_pct") @db.Decimal(5, 2)
  publicHeadline  String?  @map("public_headline")
  publicSubtext   String?  @map("public_subtext")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("referral_rules")
}

// ---------------------------------------------------------------------------
// Transactions / Cuelinks postback
// ---------------------------------------------------------------------------

model Transaction {
  id                    String            @id @default(cuid())
  storeId               String            @map("store_id")
  clickId               String            @map("click_id")
  campaignId            String?           @map("campaign_id")
  cashbackRuleId        String?           @map("cashback_rule_id")
  cuelinksTransactionId String            @map("cuelinks_transaction_id")
  orderId               String?           @map("order_id")
  saleAmount            Decimal           @map("sale_amount") @db.Decimal(12, 2)
  currency              String            @default("INR")
  commissionAmount      Decimal           @map("commission_amount") @db.Decimal(12, 2)
  customerAmount        Decimal           @default(0) @map("customer_amount") @db.Decimal(12, 2)
  profitLinkAmount      Decimal           @default(0) @map("profit_link_amount") @db.Decimal(12, 2)
  referralAmount        Decimal           @default(0) @map("referral_amount") @db.Decimal(12, 2)
  platformAmount        Decimal           @default(0) @map("platform_amount") @db.Decimal(12, 2)
  status                TransactionStatus @default(PENDING)
  rawPostbackPayload    Json?             @map("raw_postback_payload")
  transactionDate       DateTime?         @map("transaction_date")
  confirmedAt           DateTime?         @map("confirmed_at")
  reversedAt            DateTime?         @map("reversed_at")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  store        Store         @relation(fields: [storeId], references: [id])
  click        Click         @relation(fields: [clickId], references: [id])
  campaign     Campaign?     @relation(fields: [campaignId], references: [id])
  cashbackRule CashbackRule? @relation(fields: [cashbackRuleId], references: [id])

  @@unique([storeId, cuelinksTransactionId])
  @@index([clickId])
  @@index([status])
  @@map("transactions")
}

model CuelinksPostback {
  id            String   @id @default(cuid())
  rawParams     Json     @map("raw_params")
  tokenValid    Boolean  @map("token_valid")
  clickId       String?  @map("click_id")
  transactionId String?  @map("transaction_id")
  processResult String   @map("process_result")
  errorMessage  String?  @map("error_message")
  receivedAt    DateTime @default(now()) @map("received_at")

  @@index([clickId])
  @@index([receivedAt])
  @@map("cuelinks_postbacks")
}

// ---------------------------------------------------------------------------
// Commission rules
// ---------------------------------------------------------------------------

model CashbackRule {
  id            String   @id @default(cuid())
  storeId       String   @map("store_id")
  customerPct   Decimal  @map("customer_pct") @db.Decimal(5, 2)
  profitLinkPct Decimal  @map("profit_link_pct") @db.Decimal(5, 2)
  referralPct   Decimal  @map("referral_pct") @db.Decimal(5, 2)
  platformPct   Decimal  @map("platform_pct") @db.Decimal(5, 2)
  fixedAmount   Decimal? @map("fixed_amount") @db.Decimal(12, 2)
  maxCashback   Decimal? @map("max_cashback") @db.Decimal(12, 2)
  minOrderValue Decimal? @map("min_order_value") @db.Decimal(12, 2)
  validityDays  Int?     @map("validity_days")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([storeId])
  @@index([isActive])
  @@map("cashback_rules")
}

// ---------------------------------------------------------------------------
// Settings / Audit
// ---------------------------------------------------------------------------

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
