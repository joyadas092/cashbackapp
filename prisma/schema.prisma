generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

enum RiskStatus {
  NORMAL
  REVIEW
  RESTRICTED
  BLOCKED

  @@map("risk_status")
}

enum StoreStatus {
  ACTIVE
  INACTIVE

  @@map("store_status")
}

enum CashbackType {
  PERCENTAGE
  FIXED

  @@map("cashback_type")
}

// PROFIT_LINK and REFERRAL click types are added in the Phase 2 migration
// alongside the profit_links / referrals tables they depend on.
enum ClickType {
  DIRECT_CASHBACK
  VISIT_STORE

  @@map("click_type")
}

enum ClickStatus {
  TRACKED
  FAILED

  @@map("click_status")
}

// More types (PROFIT_LINK_EARNING, REFERRAL_EARNING, WITHDRAWAL, ...) are
// added in Phase 2/3 alongside the features that produce them.
enum WalletTxType {
  CASHBACK_PENDING
  CASHBACK_CONFIRMED
  CASHBACK_REVERSED
  ADJUSTMENT

  @@map("wallet_tx_type")
}

enum WalletTxStatus {
  PENDING
  COMPLETED
  REVERSED

  @@map("wallet_tx_status")
}

// ---------------------------------------------------------------------------
// Users / Wallet
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phone        String?    @unique
  passwordHash String     @map("password_hash")
  name         String
  role         UserRole   @default(USER)
  referralCode String     @unique @map("referral_code")
  riskStatus   RiskStatus @default(NORMAL) @map("risk_status")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  profile           UserProfile?
  wallet             Wallet?
  clicks             Click[]
  walletTransactions WalletTransaction[]
  auditLogs          AuditLog[]

  @@map("users")
}

model UserProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique @map("user_id")
  upiId               String?  @map("upi_id")
  bankDetails         Json?    @map("bank_details")
  kycStatus           String?  @map("kyc_status")
  notificationPrefs   Json     @default("{}") @map("notification_prefs")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Wallet {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  pendingCashback  Decimal  @default(0) @db.Decimal(12, 2) @map("pending_cashback")
  confirmedBalance Decimal  @default(0) @db.Decimal(12, 2) @map("confirmed_balance")
  availableBalance Decimal  @default(0) @db.Decimal(12, 2) @map("available_balance")
  withdrawn        Decimal  @default(0) @db.Decimal(12, 2) @map("withdrawn")
  lifetimeEarned   Decimal  @default(0) @db.Decimal(12, 2) @map("lifetime_earned")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id                   String         @id @default(cuid())
  walletId             String         @map("wallet_id")
  userId               String         @map("user_id")
  type                 WalletTxType
  amount               Decimal        @db.Decimal(12, 2)
  currency             String         @default("INR")
  source               String?
  sourceTransactionId  String?        @map("source_transaction_id")
  status               WalletTxStatus @default(PENDING)
  description          String?
  createdAt            DateTime       @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([sourceTransactionId])
  @@map("wallet_transactions")
}

// ---------------------------------------------------------------------------
// Stores / Categories / Campaigns
// ---------------------------------------------------------------------------

model StoreCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  icon        String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  stores Store[]

  @@map("store_categories")
}

model Store {
  id                  String       @id @default(cuid())
  name                String
  slug                String       @unique
  logoUrl             String       @map("logo_url")
  bannerUrl           String?      @map("banner_url")
  faviconUrl          String?      @map("favicon_url")
  brandColor          String?      @map("brand_color")
  categoryId          String       @map("category_id")
  cashbackType        CashbackType @default(PERCENTAGE) @map("cashback_type")
  cashbackRate        Decimal      @db.Decimal(5, 2) @map("cashback_rate")
  cashbackDisplayText String       @map("cashback_display_text")
  description         String?
  terms               String?
  status              StoreStatus  @default(ACTIVE)
  featured            Boolean      @default(false)
  ranking             Int          @default(0)
  profitLinkEligible  Boolean      @default(false) @map("profit_link_eligible")
  cashbackEligible    Boolean      @default(true) @map("cashback_eligible")
  couponVisible       Boolean      @default(false) @map("coupon_visible")
  cuelinksCampaignId  String?      @map("cuelinks_campaign_id")
  seoTitle            String?      @map("seo_title")
  seoDescription       String?     @map("seo_description")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  category      StoreCategory   @relation(fields: [categoryId], references: [id])
  campaigns     Campaign[]
  clicks        Click[]
  cashbackRules CashbackRule[]

  @@index([categoryId])
  @@index([status, featured, ranking])
  @@map("stores")
}

model Campaign {
  id                 String    @id @default(cuid())
  storeId            String    @map("store_id")
  cuelinksCampaignId String    @unique @map("cuelinks_campaign_id")
  name               String
  status             String    @default("active")
  commissionType     String?   @map("commission_type")
  commissionValue    Decimal?  @db.Decimal(5, 2) @map("commission_value")
  rawPayload         Json?     @map("raw_payload")
  lastSyncedAt       DateTime? @map("last_synced_at")

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  clicks Click[]

  @@index([storeId])
  @@map("campaigns")
}

// ---------------------------------------------------------------------------
// Clicks
// ---------------------------------------------------------------------------

model Click {
  id          String      @id @default(cuid())
  userId      String?     @map("user_id")
  storeId     String      @map("store_id")
  campaignId  String?     @map("campaign_id")
  clickType   ClickType   @map("click_type")
  originalUrl String      @map("original_url")
  trackingUrl String      @map("tracking_url")
  subid       String?
  subid2      String?
  subid3      String?
  subid4      String?
  subid5      String?
  userAgent   String?     @map("user_agent")
  deviceType  String?     @map("device_type")
  country     String?
  status      ClickStatus @default(TRACKED)
  createdAt   DateTime    @default(now()) @map("created_at")

  user     User?     @relation(fields: [userId], references: [id])
  store    Store     @relation(fields: [storeId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@index([userId])
  @@index([storeId])
  @@index([createdAt])
  @@map("clicks")
}

// ---------------------------------------------------------------------------
// Commission rules
// ---------------------------------------------------------------------------

model CashbackRule {
  id            String   @id @default(cuid())
  storeId       String   @map("store_id")
  customerPct   Decimal  @db.Decimal(5, 2) @map("customer_pct")
  profitLinkPct Decimal  @db.Decimal(5, 2) @map("profit_link_pct")
  referralPct   Decimal  @db.Decimal(5, 2) @map("referral_pct")
  platformPct   Decimal  @db.Decimal(5, 2) @map("platform_pct")
  fixedAmount   Decimal? @db.Decimal(12, 2) @map("fixed_amount")
  maxCashback   Decimal? @db.Decimal(12, 2) @map("max_cashback")
  minOrderValue Decimal? @db.Decimal(12, 2) @map("min_order_value")
  validityDays  Int?     @map("validity_days")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([isActive])
  @@map("cashback_rules")
}

// ---------------------------------------------------------------------------
// Settings / Audit
// ---------------------------------------------------------------------------

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?  @map("actor_user_id")
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  metadata     Json?
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
